<mujoco model="reacher">
  <compiler angle="radian" inertiafromgeom="true"/>
  <default>
    <joint armature="1" damping="1" limited="true"/>
    <geom conaffinity="0" contype="0" friction="1 0.1 0.1" rgba="0.4 0.33 0.26 1.0"/>
  </default>
  <!-- Removed RK4 integrator for brax. -->
  <option gravity="0 0 -9.81" timestep="0.01" />
  <visual>
    <headlight ambient="0.5 0.5 0.5" diffuse="0.9 0.9 0.9" specular="0.2 0.2 0.2"/>
    <map znear="0.01" zfar="30"/>
  </visual>
  <worldbody>
    <light diffuse=".5 .5 .5" pos="0 0 3" dir="0 0 -1"/>
    <!-- Arena -->
    <geom conaffinity="0" contype="0" name="ground" pos="0 0 0" size="1 1 10" type="plane" rgba="0.6 0.8 0.8 1"/>
    <geom name="inner_floor" type="box" size="0.3 0.3 0.001" pos="0 0 0.002" rgba="0.7 0.9 0.9 1" condim="3"/>
    <camera name="fixedfar" pos="0 -0.6 0.6" zaxis="0 -1 1" mode="fixed"/>
    <geom conaffinity="0" fromto="-.3 -.3 .01 .3 -.3 .01" name="sideS" size=".02" type="capsule"/>
    <geom conaffinity="0" fromto=" .3 -.3 .01 .3  .3 .01" name="sideE" size=".02" type="capsule"/>
    <geom conaffinity="0" fromto="-.3  .3 .01 .3  .3 .01" name="sideN" size=".02" type="capsule"/>
    <geom conaffinity="0" fromto="-.3 -.3 .01 -.3 .3 .01" name="sideW" size=".02" type="capsule"/>
    <!-- Arm -->
    <geom conaffinity="0" contype="0" fromto="0 0 0 0 0 0.02" name="root" size=".011" type="capsule"/>
    <body name="body0" pos="0 0 .01">
      <geom fromto="0 0 0 0.1 0 0" name="link0" size=".01" type="capsule"/>
      <joint axis="0 0 1" limited="false" name="joint0" pos="0 0 0" type="hinge"/>
      <body name="body1" pos="0.1 0 0">
        <!-- Added onboard cameras and agent site for safegoal rendering -->
        <camera name="vision" pos="0 0 0.05" xyaxes="0 -1 0 0 0 1" fovy="90"/>
        <camera name="vision_back" pos="0 0 0.05" xyaxes="0 1 0 0 0 1" fovy="90"/>
        <site name="agent" pos="0.05 0 0" size="0.01" type="sphere" rgba="1 0 0 0.1"/>
        <joint axis="0 0 1" limited="true" name="joint1" pos="0 0 0" range="-3.0 3.0" type="hinge"/>
        <geom fromto="0 0 0 0.1 0 0" name="link1" size=".01" type="capsule"/>
        <body name="fingertip" pos="0.11 0 0">
          <geom contype="0" name="fingertip" pos="0 0 0" size=".01" type="sphere"/>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" gear="200.0" joint="joint0"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" gear="200.0" joint="joint1"/>
  </actuator>
</mujoco>
