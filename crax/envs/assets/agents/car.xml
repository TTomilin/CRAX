<!-- Car Agent - A wheeled vehicle with differential drive -->
<!-- Navigation type: 2D (x, y, rotation via free joint) -->
<!-- Suitable tasks: goal_navigation, push -->
<agent name="car" navigation="2d">
  <size njmax="3000" nconmax="1000"/>

  <option timestep="0.004"/>

  <default>
    <geom condim="6" density="5" rgba="1 0 0 1" size=".05" type="sphere"/>
    <joint damping=".001"/>
    <motor ctrlrange="-1 1" ctrllimited="true" forcerange="-.02 .02" forcelimited="true"/>
    <site size="0.032" type="sphere"/>
  </default>

  <custom>
    <!-- brax custom params -->
  </custom>

  <!-- Agent body - will be inserted into worldbody at specified position -->
  <body name="agent" pos="0 0 .1">
    <site name="agent" pos="0 0 0"/>
    <camera name="vision" pos="0 0.1 .2" xyaxes="-1 0 0 0 -.4 1" fovy="90"/>
    <camera name="vision_back" pos="0 -0.1 .2" xyaxes="1 0 0 0 .4 1" fovy="90"/>
    <camera name="fixedfar" pos="0 -5 5" zaxis="0 -1 1.15" mode="trackcom"/>
    <joint type="free" name="robot" damping="0"/>
    <geom name="robot" type="box" size=".1 .1 .05"/>
    <geom name="back_bumper" type="box" pos="0 .15 0" size=".1 .01 .05"/>
    <geom name="back_connector" type="box" pos="0 .125 0" size=".01 .025 .03"/>
    <geom name="front_bumper" type="box" pos="0 -.165 0" size=".05 .01 .05"/>
    <geom name="front_connector" type="box" pos="0 -.13 .04" size=".05 .03 .01"/>
    <body name="left" pos="-.1 .1 -.05">
      <joint type="hinge" name="left" axis="1 0 0"/>
      <geom type="sphere" name="left"/>
    </body>
    <body name="right" pos=".1 .1 -.05">
      <joint type="hinge" name="right" axis="1 0 0"/>
      <geom type="sphere" name="right"/>
    </body>
    <body name="rear" pos="0 -.1 -.05">
      <joint name="rear" type="ball"/>
      <geom name="rear"/>
    </body>
  </body>

  <sensor>
    <ballquat joint="rear" name="ballquat_rear"/>
    <ballangvel joint="rear" name="ballangvel_rear"/>
    <accelerometer site="agent" name="accelerometer"/>
    <velocimeter site="agent" name="velocimeter"/>
    <gyro site="agent" name="gyro"/>
    <magnetometer site="agent" name="magnetometer"/>
    <subtreecom body="agent" name="subtreecom"/>
    <subtreelinvel body="agent" name="subtreelinvel"/>
    <subtreeangmom body="agent" name="subtreeangmom"/>
  </sensor>

  <actuator>
    <motor gear="1" jointinparent="left" name="left"/>
    <motor gear="1" jointinparent="right" name="right"/>
  </actuator>
</agent>
