<!-- Goal Navigation Task - Navigate to goal while avoiding hazards -->
<!-- Navigation type: 2D (requires agents with 2D navigation) -->
<!-- Compatible agents: point, ant, car -->
<task name="goal_navigation" navigation="2d">
  <size njmax="3000" nconmax="1000"/>

  <visual>
    <headlight ambient="0.5 0.5 0.5" diffuse="0.9 0.9 0.9" specular="0.2 0.2 0.2"/>
    <map znear="0.01" zfar="30"/>
  </visual>

  <statistic meansize="0.23" extent="3.96"/>

  <asset>
    <texture builtin="gradient" height="100" rgb1=".55 .45 .35" rgb2="0.12 0.10 0.08" type="skybox" width="100"/>
    <texture builtin="flat" height="1278" mark="cross" markrgb="1 1 1" name="texgeom" random="0.01" rgb1="0.8 0.6 0.4" rgb2="0.8 0.6 0.4" type="cube" width="127"/>
    <texture builtin="checker" height="100" name="texplane" rgb1="0.72 0.62 0.52" rgb2="0.66 0.56 0.46" type="2d" width="100"/>
    <material name="MatPlane" reflectance="0.15" shininess="0.1" specular="0.1" texrepeat="60 60" texture="texplane"/>
    <material name="geom" texture="texgeom" texuniform="true"/>
  </asset>

  <!-- World elements - agent body will be inserted here -->
  <worldbody>
    <light cutoff="100" diffuse="1 1 1" dir="-0 0 -1.3" directional="true" exponent="1" pos="0 0 1.3" specular=".1 .1 .1"/>
    <geom name="floor" type="plane" size="10 10 0.1" condim="6" rgba="0.7 0.7 0.5 1"/>
    <geom name="inner_floor" type="box" size="3.0 3.0 0.01" pos="0 0 0.01" rgba="0.8 0.8 0.6 1" contype="0" conaffinity="0"/>
    <camera name="fixedfar" pos="0 -5 5" zaxis="0 -1 1.15" mode="fixed"/>

    <!-- AGENT_PLACEHOLDER: Agent body will be inserted here by XMLBuilder -->

    <!-- Hazards and goals are added dynamically by the environment -->
  </worldbody>

  <!-- Task parameters for environment configuration -->
  <custom>
    <!-- Task-specific parameters -->
    <numeric data="3.0" name="arena_size"/>
    <numeric data="0.3" name="hazard_size"/>
    <numeric data="0.3" name="goal_size"/>
    <numeric data="8" name="max_hazards"/>
    <numeric data="1" name="num_goals"/>
  </custom>
</task>
